# DRAFT until the dataset is published: date-released (and a DOI, if a Zenodo record is made)
# are added then.
cff-version: 1.2.0
message: "If you use CommonsWire, please cite it as below, and credit the newsrooms as each row asks."
type: software
title: "CommonsWire: a living, full-text corpus of openly licensed news"
abstract: >-
  CommonsWire collects the full text of news articles whose publishers allow redistribution
  (public domain and Creative Commons licenses), checks each source's rights on its own pages,
  and keeps every article's license and credit line with it. Version 0.1.0 holds 47,585
  articles from six sources; coded variables (topic, frame, types of sources quoted, tone) are
  planned for later versions.
authors:
  - family-names: Kraishan
    given-names: Obada
    affiliation: "College of Media and Communication, Texas Tech University"
license: Apache-2.0
repository-code: "https://github.com/obadaKraishan/commonswire"
keywords:
  - news
  - corpus
  - journalism
  - communication research
  - creative commons
  - content analysis
preferred-citation:
  type: data
  title: "CommonsWire: a full-text corpus of openly licensed news"
  version: "0.1.0"
  year: 2026
  authors:
    - family-names: Kraishan
      given-names: Obada
      affiliation: "College of Media and Communication, Texas Tech University"
  publisher:
    name: "Hugging Face"
  url: "https://huggingface.co/datasets/obadakr/commonswire"
